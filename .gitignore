#classic .gitignore for a React project using Node.js and Vite
###########################################

# Dependencies
node_modules/

# Production builds
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.vite/
.eslintcache

# Optional npm cache
.npm/

# Editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Testing
test-results/
playwright-report/
blob-report/
test_results_and_coverage_from_github_actions/

# Local Netlify/Vercel files
.netlify/
.vercel/

# Docker
.docker/

# For a Vite project, you might want to keep .env.example in Git:
.env*
!.env.example

#publish
publish/


